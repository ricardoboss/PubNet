@inherits TRENZ.Lib.RazorMail.Core.MailTemplateBase<PubNet.API.Mails.PasswordResetMailModel>

@{
    Subject = "Reset your PubNet password";
}

<!DOCTYPE html>
<html lang="en">
<body>
<h1>Reset your PubNet password</h1>

<p>
    A password reset was requested for the account <strong>@Model.UserName</strong>. Follow this link to choose
    a new password:
</p>

<p>
    <a href="@Model.ResetUrl">@Model.ResetUrl</a>
</p>

<p>
    The link is valid for @Model.ValidFor.TotalMinutes.ToString("0") minutes and can only be used once.
    If you did not request this, you can ignore this e-mail; your password stays unchanged.
</p>
</body>
</html>
