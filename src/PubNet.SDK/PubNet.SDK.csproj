<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<MSBuildWarningsAsMessages>CS0618</MSBuildWarningsAsMessages>

		<ApiProjectFolder>$(MSBuildThisFileDirectory)../PubNet.API/</ApiProjectFolder>
	</PropertyGroup>

	<!--
		Kiota.MSBuild generates and refreshes Generated/ from the API's openapi document. Everything
		else it needs matches its defaults: Generated/ as the output folder, $(RootNamespace).Generated
		as the namespace, the repository's tool manifest, application/json as the structured mime type,
		the JSON (de)serializers, and excluding backward compatible members.
	-->
	<PropertyGroup>
		<SpecFile>$(ApiProjectFolder)PubNet_openapi.json</SpecFile>
		<GeneratedClientClassName>PubNetApiClient</GeneratedClientClassName>
	</PropertyGroup>

	<ItemGroup>
		<Watch Include="$(SpecFile)"/>
	</ItemGroup>

	<ItemGroup>
		<!-- To ensure the spec file is up-to-date -->
		<ProjectReference Include="$(ApiProjectFolder)PubNet.API.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" />
		<PackageReference Include="Kiota.MSBuild" PrivateAssets="all"/>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Kiota.Abstractions"/>
		<PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary"/>
		<PackageReference Include="Microsoft.Kiota.Serialization.Json"/>
		<PackageReference Include="Scrutor" />
	</ItemGroup>

</Project>
