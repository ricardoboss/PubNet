@page "/onboarding"
@inject IOnboardingService OnboardingApi
@inject OnboardingService OnboardingStatus
@inject IAuthenticationService Auth
@inject ILoginTokenStorage TokenStore
@inject NavigationManager Nav

<PageTitle>Set up PubNet</PageTitle>

@if (_pending is null)
{
	<p>
		<em>Please wait...</em>
	</p>
}
else if (!_pending.Value)
{
	<Heading Size="HeadingSize.Is1">Already set up</Heading>

	<p>This instance has already been set up. <NavLink href="/authenticate">Log in</NavLink> to continue.</p>
}
else
{
	<Heading Size="HeadingSize.Is1">Welcome to PubNet!</Heading>

	<Alert Color="Color.Info" Visible>
		<strong>Nobody administers this instance yet.</strong>
		Create the admin account below to finish the setup.
	</Alert>

	<RegisterForm Model="Request" OnValidSubmit="SubmitAsync" SubmitLabel="Finish setup"
	              Submitting="_submitting" Error="@Error"/>
}

@code {

	private bool? _pending;

	private bool _submitting;

	private RegisterRequestDto Request { get; } = new();

	private string? Error { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		_pending = await OnboardingStatus.IsPendingAsync();
	}

	private async Task SubmitAsync()
	{
		Error = null;
		_submitting = true;

		try
		{
			_ = await OnboardingApi.CompleteAsync(Request);

			OnboardingStatus.Invalidate();

			// log the new admin in right away so they land in a usable instance
			try
			{
				var token = await Auth.LoginAsync(Request.Email!, Request.Password!);
				if (token.Token is not null)
				{
					await TokenStore.StoreTokenAsync(token.Token);

					Nav.NavigateTo("/?message=welcome-back", true);

					return;
				}
			}
			catch (PubNetSdkException)
			{
				// the account exists either way, so fall through to the login page
			}

			Nav.NavigateTo("/authenticate", true);
		}
		catch (PubNetSdkException e)
		{
			Error = e.Message;
		}
		finally
		{
			_submitting = false;
		}
	}

}
