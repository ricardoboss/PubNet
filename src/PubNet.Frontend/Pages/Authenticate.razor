@page "/authenticate"
@using PubNet.API.DTO
@inject ApiClient Http;
@inject OnboardingService Onboarding
@inject NavigationManager Nav

@if (MessageBoxContent is not null)
{
    <Alert Color="Color.Warning" Dismisable Visible>
        @MessageBoxContent
    </Alert>
}

<Heading Size="HeadingSize.Is1">Login</Heading>

<LoginForm/>

<Divider/>

@if (_showRegistration)
{
    <Heading Size="HeadingSize.Is1">Register</Heading>

    <RegisterForm Model="_registration" OnValidSubmit="RegisterAsync" Submitting="_registering"
                  Error="@_registerError" Success="@_registerSuccess"/>
}
else
{
    <p>
        Registrations are currently disabled.
    </p>
}

@code {

    private bool _showRegistration;

    private bool _registering;

    private RegisterRequest _registration = new();

    private string? _registerError;

    private string? _registerSuccess;

    [Parameter]
    [SupplyParameterFromQuery(Name = "message")]
    public string? Message { get; set; }

    private string? MessageBoxContent => Message switch {
        "session-expired" => "Your session has expired. Please log in again.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // there is nothing to log into yet, and the layout only checks this when it is first created, so a
        // client-side navigation from anywhere else would land here
        if (await Onboarding.IsPendingAsync())
        {
            Nav.NavigateTo("/onboarding");

            return;
        }

        _showRegistration = await Http.GetAsync<bool>("authentication/registrations-enabled");
    }

    private async Task RegisterAsync()
    {
        _registerError = null;
        _registerSuccess = null;
        _registering = true;

        try
        {
            var response = await Http.PostAsync("authentication/register", _registration);
            if (!response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadFromJsonAsync<ErrorResponse>();

                _registerError = message?.Error?.Message ?? "The account could not be created.";

                return;
            }

            _registration = new();

            _registerSuccess = "Registration complete. You can now log in.";
        }
        finally
        {
            _registering = false;
        }
    }

}
