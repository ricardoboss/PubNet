@page "/forgot-password"
@inject IAuthenticationService Auth
@inject NavigationManager Nav

<Heading Size="HeadingSize.Is1">Forgot password</Heading>

@if (_sent)
{
	<Alert Color="Color.Success" Visible>
		<strong>Check your inbox.</strong> A password reset link is on its way to your e-mail address.
	</Alert>

	<p>
		<NavLink href="/authenticate">Back to login</NavLink>
	</p>
}
else
{
	@if (_error is not null)
	{
		<Alert Color="Color.Danger" Visible>
			<strong>That didn't work.</strong> @_error
		</Alert>
	}

	<p class="block">
		Enter the e-mail address of your account, and you will receive a link to choose a new password.
	</p>

	<Form @onsubmit="SubmitAsync">
		<Validations @ref="_validations" Mode="ValidationMode.Manual" Model="_model">
			<Validation Validator="@FormValidators.RequiredEmail">
				<Field Horizontal>
					<FieldLabel ColumnSize="ColumnSize.Is2">E-Mail</FieldLabel>
					<FieldBody ColumnSize="ColumnSize.Is10">
						<TextInput Placeholder="Your e-mail address" Role="@TextRole.Email"
						           @bind-Value="@_model.Email" Autocomplete="email">
							<Feedback>
								<ValidationError/>
							</Feedback>
						</TextInput>
					</FieldBody>
				</Field>
			</Validation>
			<Field Horizontal>
				<FieldLabel ColumnSize="ColumnSize.Is2"/>
				<FieldBody ColumnSize="ColumnSize.Is10">
					<div class="is-flex is-align-items-center">
						<Button Color="Color.Primary" Clicked="@SubmitAsync" Type="ButtonType.Submit"
						        Disabled="@_submitting">
							Send reset link
						</Button>
						<NavLink class="ml-4" href="/authenticate">Back to login</NavLink>
					</div>
				</FieldBody>
			</Field>
		</Validations>
	</Form>
}

@code {

	private Validations? _validations;

	private ForgotPasswordRequestDto _model = new();

	private bool _submitting;

	private bool _sent;

	private string? _error;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		if (await Auth.IsAuthenticatedAsync())
			Nav.NavigateTo("/");
	}

	private async Task SubmitAsync()
	{
		if (_submitting || _validations is null || !await _validations.ValidateAll())
			return;

		_error = null;

		// The validator above rejects empty values, but it runs in the browser and the DTO is nullable,
		// so this stays as a real check.
		if (_model.Email is not { } email || string.IsNullOrWhiteSpace(email))
		{
			_error = "Please enter your e-mail address";

			return;
		}

		_submitting = true;

		try
		{
			await Auth.RequestPasswordResetAsync(email);

			_sent = true;
		}
		catch (PubNetSdkException e)
		{
			_error = e.Message;
		}
		finally
		{
			_submitting = false;
		}
	}

}
