@page "/reset-password"
@inject IAuthenticationService Auth
@inject NavigationManager Nav

<Heading Size="HeadingSize.Is1">Reset password</Heading>

@if (string.IsNullOrWhiteSpace(Token))
{
	<Alert Color="Color.Warning" Visible>
		This page can only be reached through the link in a password reset e-mail.
		<NavLink href="/forgot-password">Request a new one</NavLink> if yours is missing.
	</Alert>
}
else
{
	@if (_error is not null)
	{
		<Alert Color="Color.Danger" Visible>
			<strong>That didn't work.</strong> @_error
		</Alert>
	}

	<p>
		Choose a new password for your account.
	</p>

	<Form @onsubmit="SubmitAsync">
		<Validations @ref="_validations" Mode="ValidationMode.Manual" Model="_model">
			<Validation Validator="@(e => FormValidators.Required(e, "Password"))">
				<Field Horizontal>
					<FieldLabel ColumnSize="ColumnSize.Is2">New password</FieldLabel>
					<FieldBody ColumnSize="ColumnSize.Is10">
						<TextInput Placeholder="Your new password" Role="@TextRole.Password"
						           @bind-Value="@_model.Password" Autocomplete="new-password">
							<Feedback>
								<ValidationError/>
							</Feedback>
						</TextInput>
					</FieldBody>
				</Field>
			</Validation>
			<Validation Validator="@ConfirmationMatches">
				<Field Horizontal>
					<FieldLabel ColumnSize="ColumnSize.Is2">Repeat password</FieldLabel>
					<FieldBody ColumnSize="ColumnSize.Is10">
						<TextInput Placeholder="Your new password, again" Role="@TextRole.Password"
						           @bind-Value="@_confirmation" Autocomplete="new-password">
							<Feedback>
								<ValidationError/>
							</Feedback>
						</TextInput>
					</FieldBody>
				</Field>
			</Validation>
			<Field Horizontal>
				<FieldLabel ColumnSize="ColumnSize.Is2"/>
				<FieldBody ColumnSize="ColumnSize.Is10">
					<Button Color="Color.Primary" Clicked="@SubmitAsync" Type="ButtonType.Submit"
					        Disabled="@_submitting">
						Set new password
					</Button>
				</FieldBody>
			</Field>
		</Validations>
	</Form>
}

@code {

	private Validations? _validations;

	private ResetPasswordRequestDto _model = new();

	private string? _confirmation;

	private bool _submitting;

	private string? _error;

	[Parameter]
	[SupplyParameterFromQuery(Name = "token")]
	public string? Token { get; set; }

	private void ConfirmationMatches(ValidatorEventArgs e)
	{
		FormValidators.Required(e, "Repeating the password");
		if (e.Status == ValidationStatus.Error)
			return;

		if (!string.Equals(Convert.ToString(e.Value), _model.Password, StringComparison.Ordinal))
		{
			e.Status = ValidationStatus.Error;
			e.ErrorText = "The passwords do not match";
		}
	}

	private async Task SubmitAsync()
	{
		if (_submitting || _validations is null || !await _validations.ValidateAll())
			return;

		_error = null;

		// The validators above reject empty values, but they run in the browser and the DTO is nullable,
		// so this stays as a real check.
		if (Token is not { } token || _model.Password is not { } password || string.IsNullOrWhiteSpace(password))
		{
			_error = "Please fill in all required fields";

			return;
		}

		_submitting = true;

		try
		{
			await Auth.ResetPasswordAsync(token, password);

			Nav.NavigateTo("/authenticate?message=password-reset");
		}
		catch (PubNetSdkException e)
		{
			_error = e.Message;
		}
		finally
		{
			_submitting = false;
		}
	}

}
