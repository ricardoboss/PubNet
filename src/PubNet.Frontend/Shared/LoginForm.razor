@inject ILoginTokenStorage TokenStore
@inject IAuthenticationService Auth
@inject NavigationManager Nav

@if (Error is not null)
{
	<Alert Color="Color.Danger" Visible>
		<strong>That didn't work.</strong> @Error
	</Alert>
}

@if (Success is not null)
{
	<Alert Color="Color.Success" Visible>
		<strong>Success!</strong> @Success
	</Alert>
}

<Form @onsubmit="Submit">
	<Validations @ref="_validations" Mode="ValidationMode.Manual" Model="LoginRequest">
		<Validation Validator="@FormValidators.RequiredEmail">
			<Field Horizontal>
				<FieldLabel ColumnSize="ColumnSize.Is2">E-Mail</FieldLabel>
				<FieldBody ColumnSize="ColumnSize.Is10">
					<TextInput Placeholder="Your e-mail address" Role="@TextRole.Email"
					           @bind-Value="@LoginRequest.Email" Autocomplete="email">
						<Feedback>
							<ValidationError/>
						</Feedback>
					</TextInput>
				</FieldBody>
			</Field>
		</Validation>
		<Validation Validator="@(e => FormValidators.Required(e, "Password"))">
			<Field Horizontal>
				<FieldLabel ColumnSize="ColumnSize.Is2">Password</FieldLabel>
				<FieldBody ColumnSize="ColumnSize.Is10">
					<TextInput Placeholder="Your password" Role="@TextRole.Password"
					           @bind-Value="@LoginRequest.Password" Autocomplete="current-password">
						<Feedback>
							<ValidationError/>
						</Feedback>
					</TextInput>
				</FieldBody>
			</Field>
		</Validation>
		<Field Horizontal>
			<FieldLabel ColumnSize="ColumnSize.Is2"/>
			<FieldBody ColumnSize="ColumnSize.Is10">
				<Button Color="Color.Primary" Clicked="@Submit" Type="ButtonType.Submit">Login</Button>
				<NavLink href="/forgot-password">Forgot password?</NavLink>
			</FieldBody>
		</Field>
	</Validations>
</Form>

@code {
	private Validations? _validations;

	private LoginRequestDto LoginRequest { get; set; } = new();

	private string? Error { get; set; }

	private string? Success { get; set; }

	private async Task Submit()
	{
		if (_validations is null || !await _validations.ValidateAll())
			return;

		Error = null;
		Success = null;

		// The validators above reject empty values, but they run in the browser and the DTO is nullable,
		// so this stays as a real check.
		if (LoginRequest.Email is not { } email || LoginRequest.Password is not { } password)
		{
			Error = "Please fill in all required fields";

			return;
		}

		try
		{
			var response = await Auth.LoginAsync(email, password);
			if (response.Token is null)
				return;

			await TokenStore.StoreTokenAsync(response.Token);
			await Auth.GetSelfAsync();

			Nav.NavigateTo("/?message=welcome-back", true);
		}
		catch (Exception e)
		{
			Error = e.Message;
		}
	}

}
